# Copy this file to .env.local and replace both values from Supabase's Connect dialog.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Vercel server function only. Never prefix this secret with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Comma-separated accounts allowed to open the protected superadmin panel.
SUPERADMIN_EMAILS=owner@example.com
